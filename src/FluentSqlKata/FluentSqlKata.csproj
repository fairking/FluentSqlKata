<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Version>2.0.0</Version>
    <PackageProjectUrl>https://github.com/fairking/FluentSqlKata</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/fairking/FluentSqlKata</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>sql;query;orm;sqlkata;database;fluent</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Description>The fluent way to build sql queries</Description>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SqlKata" Version="4.0.1" />
  </ItemGroup>

</Project>
